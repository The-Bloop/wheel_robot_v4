    <mu2 value="0.25"/>
    <fdir1 value="1 0 0"/>
    <slip1 value="0.0"/>
    <slip2 value="0.0"/>
    <soft_cfm value="0.0"/>
    <soft_erp value="0.2"/>
    <kp value="1e+5"/>
