  <joint name="wheelbl_joint" type="continuous">
    <origin rpy="-1.571 0 0" xyz="-0.1 0.1125 -0.0375"/>
    <parent link="base_link"/>
    <child link="wheelbl_link"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="wheelbr_joint" type="continuous">
    <origin rpy="-1.571 0 0" xyz="-0.1 -0.1125 -0.0375"/>
    <parent link="base_link"/>
    <child link="wheelbr_link"/>
    <axis xyz="0 0 1"/>
  </joint>
